# OLMART environment template. Copy to .env locally; never put real credentials here.
# Required/optional status depends on enabling the matching feature and deployment platform.

# Server runtime
PORT=3000 # Optional; application listens on 3000 and adds a listener here when different.
NODE_ENV=development # Local development only; hosting platform should set production.
LOG_LEVEL=info # Optional server log verbosity.

# Security and origins (server only)
CSRF_SECRET= # Production required: generate a unique random value >=32 characters. Dev/test uses an ephemeral value.
ALLOWED_ORIGINS= # Optional: comma-separated exact additional trusted origins.
CANONICAL_DOMAIN=olmart.dz # Optional: redirect target when canonical-domain enforcement is enabled.
ENFORCE_CANONICAL_DOMAIN=false # Optional; enable only after production domain/DNS is ready.
DANGER_ZONE_SECRET= # Non-production only; never configure in production (reset route is disabled there).
CRON_SECRET= # Required only when calling the protected tracking-sync cron endpoint.

# Firebase client configuration (VITE_* values are public in the browser; never use them for secrets)
VITE_FIREBASE_API_KEY= # Required if not supplied by the checked-in Firebase applet config; restrict by referrer and enable App Check.
VITE_FIREBASE_AUTH_DOMAIN= # Required if not supplied by applet config.
VITE_FIREBASE_PROJECT_ID= # Required if not supplied by applet config.
VITE_FIREBASE_APP_ID= # Required if not supplied by applet config.
VITE_FIREBASE_STORAGE_BUCKET= # Optional; needed for Firebase Storage (falls back to server bucket config).
VITE_FIREBASE_MESSAGING_SENDER_ID= # Optional Firebase client setting.
VITE_FIREBASE_MEASUREMENT_ID= # Optional Firebase Analytics setting.
VITE_FIREBASE_DATABASE_ID=(default) # Optional; default Firestore database unless another is configured.
VITE_MIN_ORDER_AMOUNT=100 # Optional public UI hint; server-side amount remains authoritative.
VITE_SENTRY_DSN= # Optional public Sentry client DSN (not an authentication secret).

# Firebase Admin/server configuration
FIREBASE_PROJECT_ID= # Required for Firebase Admin when it cannot be inferred from Google application credentials.
FIREBASE_DATABASE_ID=(default) # Optional; use (default) unless using a named Firestore database.
FIREBASE_STORAGE_BUCKET= # Optional; required for server features that use Firebase Storage.
FIREBASE_SERVICE_ACCOUNT_KEY= # Optional only when using a JSON key; prefer ADC / Cloud Run attached service account.
GOOGLE_SERVICE_ACCOUNT_KEY= # Optional feature credential: Base64 service-account JSON for Google Drive workspace integration; keep server-side only.

# Optional server integrations
GEMINI_API_KEY= # Required only for server-side Gemini AI features.
REDIS_URL= # Optional; distributed rate limiting. Without it the app uses in-memory limits.
SMTP_HOST= # Optional; configure SMTP_* together to send real email (otherwise development Ethereal defaults may be used).
SMTP_PORT=587
SMTP_USER=
SMTP_PASS= # Server secret; never expose as VITE_*.
SENTRY_DSN= # Optional server-side Sentry DSN.

# Optional operational settings
MIN_ORDER_AMOUNT=100 # Optional server default; backend remains authoritative.
RUN_MIGRATIONS=false # Optional one-off maintenance setting; do not enable on every autoscaled app instance.
ENABLE_WORKERS=false # Optional; enable only on a worker deployment that should run background jobs.
ENABLE_BACKGROUND_WORKERS=false # Legacy alias for ENABLE_WORKERS, if still used by deployment.
